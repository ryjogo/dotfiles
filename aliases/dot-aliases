# ==============================================================================
# ~/.aliases
# Managed in ~/src/dotfiles (aliases package, linked with GNU Stow).
# Sourced from ~/.zshrc.
# ==============================================================================


# ------------------------------------------------------------------------------
# Safety & defaults
# ------------------------------------------------------------------------------
alias mv='mv -i'
alias cp='cp -i'
alias rm='rm -i'
alias df='df -h'
alias du='du -h'
alias mkdir='mkdir -p'

# Allow aliases to be sudo'ed
alias sudo='sudo '


# ------------------------------------------------------------------------------
# Navigation
# ------------------------------------------------------------------------------
alias up='cd ..'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ~='cd ~'
alias -- -='cd -'

# Directories
alias home='cd ~'
alias repos='cd ~/repos'
alias notebooks='cd ~/notebooks'
alias dev='cd ~/dev'
alias n='cd ~/node'
alias dl='cd ~/Downloads'
alias dt='cd ~/Desktop'
alias htdocs='cd /Applications/MAMP/htdocs'


# ------------------------------------------------------------------------------
# Listing & colors
# ------------------------------------------------------------------------------
# Detect which `ls` flavor is in use
if ls --color > /dev/null 2>&1; then # GNU `ls`
	colorflag="--color"
	export LS_COLORS='no=00:fi=00:di=01;31:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'
else # macOS `ls`
	colorflag="-G"
	export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
fi

alias ls="command ls ${colorflag}"                              # always colorize
alias l="ls -lF ${colorflag}"                                   # long format
alias la="ls -lAF ${colorflag}"                                 # long format, excluding . and ..
alias lsd="ls -lF ${colorflag} | grep --color=never '^d'"      # directories only

# Colored grep (GREP_OPTIONS is deprecated, hence the aliases)
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'


# ------------------------------------------------------------------------------
# Git
# ------------------------------------------------------------------------------
alias g='git'
alias gs='git status '
alias ga='git add '
alias gb='git branch '
alias gc='git commit'
alias gd='git diff'
alias lg='lazygit'
alias gk='gitk --all&'
alias gx='gitx --all'


# ------------------------------------------------------------------------------
# Kubernetes
# ------------------------------------------------------------------------------
alias k=kubectl
alias kx=kubectx
alias kn=kubens
alias knetic='export KUBECONFIG=~/.kube/netic'

# k9s<env><n>: one alias per Netic cluster (dev/stage/prod, 1-4)
function set_k9s_aliases() {
    for env in dev stage prod; do
        for number in 1 2 3 4; do
            local kubeconfig_path="~/.kube/netic-${env}${number}"
            alias "k9s${env}${number}=k9s --kubeconfig ${kubeconfig_path} --logoless"
        done
    done
}

set_k9s_aliases


# ------------------------------------------------------------------------------
# Apps
# ------------------------------------------------------------------------------
alias firefox='open -a Firefox'
alias chrome='open -a Google\ Chrome'
alias safari='open -a Safari'
alias code='open -a "Visual Studio Code"'

# JavaScriptCore REPL
jscbin="/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Resources/jsc"
[ -e "${jscbin}" ] && alias jsc="${jscbin}"
unset jscbin


# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------
alias ip='dig +short myip.opendns.com @resolver1.opendns.com'
alias localip='ipconfig getifaddr en0'
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Show active network interfaces
alias ifactive="ifconfig | pcregrep -M -o '^[^\t:]+:([^\n]|\n\t)*status: active'"

# Flush DNS caches
alias flush='dscacheutil -flushcache && killall -HUP mDNSResponder'
alias cleardns='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo "DNS cache cleared"'


# ------------------------------------------------------------------------------
# Utilities
# ------------------------------------------------------------------------------
alias week='date +%V'                    # current week number
alias c="tr -d '\n' | pbcopy"            # trim newlines and copy to clipboard

# Fallbacks for tools macOS lacks or names differently
command -v hd > /dev/null || alias hd='hexdump -C'
command -v md5sum > /dev/null || alias md5sum='md5'
command -v sha1sum > /dev/null || alias sha1sum='shasum'


# ------------------------------------------------------------------------------
# macOS maintenance
# ------------------------------------------------------------------------------
# Update macOS, Homebrew, npm and Ruby gems
alias update='sudo softwareupdate -i -a; brew update; brew upgrade; brew cleanup; npm install npm -g; npm update -g; sudo gem update --system; sudo gem update; sudo gem cleanup'

# Recursively delete .DS_Store files
alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"

# Remove duplicates from the "Open With" menu
alias lscleanup='/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user && killall Finder'

# Empty the Trash on all volumes, clear Apple's system logs (faster shell startup)
# and clear the quarantine download history. https://mths.be/bum
alias emptytrash="sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash; sudo rm -rfv /private/var/log/asl/*.asl; sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* 'delete from LSQuarantineEvent'"

# Show/hide hidden files in Finder
alias show='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
alias hide='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'

# Show/hide desktop icons (useful when presenting)
alias hidedesktop='defaults write com.apple.finder CreateDesktop -bool false && killall Finder'
alias showdesktop='defaults write com.apple.finder CreateDesktop -bool true && killall Finder'
